# SecurityTriageAI — LLM Provider Configuration
# Copy this to .env and fill in your values

# ── PROVIDER SELECTION ──────────────────────────────────────────────────────
# Options: ollama | groq | bedrock
# - ollama: FREE, runs locally, requires Ollama installed (https://ollama.com)
# - groq:   FREE cloud tier, fast inference, requires free API key (https://console.groq.com)
# - bedrock: AWS Bedrock, pay-per-token (~$0.05-0.50/demo run)
LLM_PROVIDER=ollama

# ── OLLAMA (free, local) ────────────────────────────────────────────────────
# Install: https://ollama.com  |  Pull model: ollama pull llama3.1
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# ── GROQ (free cloud tier) ──────────────────────────────────────────────────
# Get free key: https://console.groq.com
# Free tier: generous rate limits, Llama 3.1 70B available
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-70b-versatile

# ── AWS BEDROCK (pay-per-token) ──────────────────────────────────────────────
# Only needed when LLM_PROVIDER=bedrock
# Requires: AWS credentials configured (aws configure)
# AWS_DEFAULT_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
